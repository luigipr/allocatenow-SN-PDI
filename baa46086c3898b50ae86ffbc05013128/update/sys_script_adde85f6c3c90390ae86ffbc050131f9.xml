        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	var base = new GlideRecord('x_1523510_alloca_0_bases');

	if (base.get(current.getValue('base'))) {

		var currentCapacity = parseInt(base.getValue('current_capacity'), 10);
		var maxCapacity = parseInt(base.getValue('capacity'), 10);

		// Só aumenta se current_capacity for menor que capacity
		if (currentCapacity < maxCapacity) {

			base.setValue('current_capacity', currentCapacity + 1);
			base.update();

		}
	}

})(current, previous);]]></script>
